{
  "name": "@lickgrass/one-click-unsub",
  "version": "0.1.1",
  "description": "RFC 8058 one-click unsubscribe: HMAC tokens, List-Unsubscribe headers, Fetch/Express handlers, and email footers. Zero runtime dependencies.",
  "license": "MIT",
  "author": "Lickgrass (https://lickgrass.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lickgrass/one-click-unsub.git"
  },
  "homepage": "https://github.com/Lickgrass/one-click-unsub#readme",
  "bugs": "https://github.com/Lickgrass/one-click-unsub/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "unsubscribe",
    "rfc8058",
    "list-unsubscribe",
    "one-click",
    "can-spam",
    "gmail",
    "yahoo",
    "bulk-sender",
    "email",
    "ses",
    "smtp"
  ],
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      },
      "default": "./dist/express.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "OPERATIONS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "benchmarks/node24-2026-09-06.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:package",
    "bench": "npm run build && node scripts/benchmark.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "express": "^5.2.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.ts"
      ]
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
